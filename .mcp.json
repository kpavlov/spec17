{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_TOOLS": "explore,node,search,callers"
      },
      "alwaysLoad": true
    },
    "spec17": {
      "type": "http",
      "url": "http://127.0.0.1:7411/mcp"
    },
    "spec17-stdio": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/spec17",
      "args": [
        "--stdio-mcp",
        "--no-http-mcp",
        "--no-ui",
        "--root",
        "/Users/maestro/code/github/kpavlov/spec17"
      ]
    }
  }
}
