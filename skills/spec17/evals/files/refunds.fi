from decimal import Decimal

FEE = Decimal("2.50")
CAP = Decimal("100")


class RefundService:
    def __init__(self, paid: Decimal):
        self.remaining = paid
        self.refunds = 0

    def refund(self, requested: Decimal) -> Decimal:
        # (REF-04)
        amount = min(requested, self.remaining, CAP)
        self.remaining -= amount
        # (REF-08)
        fee = FEE
        self.refunds += 1
        return max(amount - fee, Decimal("0"))


def receipt(service: RefundService, requested: Decimal) -> str:
    # (REF-11)
    return f"Refunded: {service.refund(requested)}"

