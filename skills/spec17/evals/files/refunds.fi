from decimal import Decimal

from src.refunds import RefundService, receipt


def test_partial_refund_up_to_balance():
    """[REF-04]"""
    s = RefundService(Decimal("300"))
    assert s.refund(Decimal("150")) == Decimal("97.50")
    assert s.refund(Decimal("500")) == Decimal("97.50")


def test_fee_per_refund():
    """[REF-08]"""
    s = RefundService(Decimal("50"))
    assert s.refund(Decimal("10")) == Decimal("7.50")
    assert s.refund(Decimal("10")) == Decimal("7.50")


def test_receipt_shows_net():
    """[REF-11]"""
    assert receipt(RefundService(Decimal("50")), Decimal("10")) == "Refunded: 7.50"

