import logging
from datetime import date

log = logging.getLogger("payments")


def authorize(card_expiry: date, today: date) -> bool:
    # (PAY-03) (PAY-08)
    if card_expiry < today:
        log.warning("payment rejected: card expired")
        return False
    return True

