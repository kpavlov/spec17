from decimal import Decimal

from src.inventory import reserve
from src.orders import order_total
from src.payments import authorize
from src.refunds import refund
from datetime import date
import pytest


def test_total_rounds_half_up():
    """[ORD-12]"""
    assert order_total([("10.005", 1)]) == Decimal("10.01")


def test_expired_card_is_rejected():
    """[PAY-03]"""
    assert not authorize(date(2020, 1, 1), date(2026, 1, 1))


def test_reserve_more_than_stock_fails():
    """[INV-04]"""
    stock = {"apple": 2}
    with pytest.raises(ValueError):
        reserve(stock, "apple", 3)
    assert stock == {"apple": 2}


def test_refund_goes_to_original_method():
    """[REF-06]"""
    payment = {"method": "card", "account": "4111-xx", "customer": "ann"}
    r = refund(payment, Decimal("5"))
    assert r["method"] == "card" and r["account"] == "4111-xx"


def test_refund_returns_amount():
    """[REF-09]"""
    payment = {"method": "card", "account": "4111-xx", "customer": "ann"}
    assert refund(payment, Decimal("5"))["amount"] == Decimal("5")

