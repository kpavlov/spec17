import logging

log = logging.getLogger("refunds")


def refund(payment: dict, amount):
    # (REF-06)
    result = {"method": payment["method"], "account": payment["account"], "amount": amount}
    notify_customer(payment["customer"], amount)
    return result


def notify_customer(customer: str, amount) -> None:
    # (REF-09) TODO: send the email; for now only log it.
    log.info("refund of %s for %s", amount, customer)

